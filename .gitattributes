# Pin line endings so the SHA-256 values in src/data/checksum_manifest.json and
# src/data/evidence_manifest.json stay valid on every checkout (Windows, macOS, Linux CI).
# Without this, core.autocrlf rewrites text files on checkout and their bytes no longer
# match the registered hashes.

# Source, manifests, and docs: always LF, in the repository and in every working copy.
* text=auto eol=lf

# Evidence-source files are hashed byte-for-byte against their original source.
# Never let git touch their bytes (the P12 CSV keeps its original CRLF line endings).
src/data/kg_sources/** -text
src/data/public_dataset_sources/** binary

*.jpg binary
*.jpeg binary
*.png binary
